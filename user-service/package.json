{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User service for Beautinique project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/generate-html.mjs",
    "dev": "concurrently -n \"TS,APP\" -c \"yellow,cyan\" \"tsc --noEmit --watch\" \"nodemon --watch src --ext ts --exec tsx src/index.ts\"",
    "start": "node dist/index.js",
    "start:dev": "npm run build && node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rmdir /s /q dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Nageshwar Pawar",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@beautinique/backend-types": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@beautinique/backend-bullmq": "^1.1.0",
    "@beautinique/backend-classes": "^1.1.0",
    "@beautinique/backend-constants": "^1.1.0",
    "@beautinique/backend-cors": "^1.1.0",
    "@beautinique/backend-logger": "^1.1.0",
    "@beautinique/backend-mongoose": "^1.1.0",
    "@beautinique/backend-request": "^1.1.0",
    "@beautinique/backend-response": "^1.1.0",
    "@beautinique/backend-utils": "^1.1.0",
    "@beautinique/backend-zod": "^1.1.0",
    "@beautinique/shared-markdown-to-html": "^1.1.0",
    "@beautinique/shared-utils": "^1.1.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "mongoose": "^9.11.0",
    "redis": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Microservice.git",
    "directory": "user-service"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Microservice/tree/main/user-service#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Microservice/issues"
  },
  "optionalDependencies": {
    "pino-pretty": "^13.2.0"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true
  }
}

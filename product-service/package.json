    "@beautinique/be-utils": "^1.0.4",
    "@beautinique/be-zod": "^1.0.17",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "mongoose": "^9.6.2",
    "redis": "^5.12.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Microservice.git",
    "directory": "product-service"
  },

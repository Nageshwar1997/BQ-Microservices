{
  "name": "mail-service",
  "version": "1.0.0",
  "description": "Mail service for Beautinique project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -n \"TS,APP\" -c \"yellow,cyan\" \"tsc --noEmit --watch\" \"nodemon --watch src --ext ts --exec tsx src/index.ts\"",
    "start": "node dist/index.js",
    "start:dev": "npm run build && node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rmdir /s /q dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Nageshwar Pawar",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "@beautinique/be-jobs": "^1.0.6",
    "@beautinique/be-middlewares": "^1.0.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html-to-text": "^10.0.0",
    "nodemailer": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Microservice.git",
    "directory": "mail-service"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Microservice/tree/main/mail-service#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Microservice/issues"
  }
}
